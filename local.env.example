# ============================================================================
#  local.env.example —— 复制成 local.env，只写【本机差异】
#
#    cp local.env.example local.env && vi local.env
#    sudo bash deploy.sh --restart
#
#  local.env 已被 .gitignore 忽略：仓库里永远是通用值，私有值留在机器上。
#  下面这些键会被 deploy.sh 写进 /etc/default/dsh-tunnel 的托管块；
#  不在允许列表里的键会被忽略（避免污染 service 环境）。
# ============================================================================

# ── 宿主机侧连接（虚拟机 → 宿主机 反向隧道）─────────────────────────────────
SSH_HOST=192.168.122.1          # 宿主机地址；libvirt NAT 下通常是默认网关
SSH_PORT=22                     # 宿主机 sshd 端口
SSH_USER=yourname               # 宿主机登录账号
#SSH_KEY=/home/you/.ssh/dsh-remote

# ── 被守护的回环服务 ────────────────────────────────────────────────────────
LOCAL_PORT=3080                 # 服务在虚拟机内监听的端口
SERVICE_LABEL="dsh web"         # 只影响日志措辞
#HEALTH_URL=http://127.0.0.1:3080/healthz
#   设了它就用 HTTP 探活替代 TCP 连通性判断（能识别"端口开着但服务没就绪"）；
#   留空则只探 TCP，适用于任何服务。

# ── 宿主机落地端口（按优先级，第一个是首选）────────────────────────────────
HOST_PORT_CANDIDATES="3080 3000"
HOST_ADDR=127.0.0.1             # 0.0.0.0 = 局域网可访问（需宿主机 GatewayPorts）

# ── 运行服务的账号（默认自动探测：仓库目录属主）─────────────────────────────
#SVC_USER=dshuser
#SVC_HOME=/home/dshuser
#SVC_BIN=/home/dshuser/.nvm/versions/node/v24.21.0/bin/dsh

# ── 时序（一般不用动）──────────────────────────────────────────────────────
#READY_GRACE=4
#RETRY_SEC=3
#UPGRADE_CHECK_SEC=60
#HEALTH_CHECK_SEC=3
#DSH_POLL_SEC=2
